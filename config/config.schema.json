{
  "$defs": {
    "ApiConfig": {
      "additionalProperties": false,
      "properties": {
        "token": {
          "default": "",
          "title": "Token",
          "type": "string"
        },
        "tokenEnv": {
          "default": "MINI_AGENT_API_TOKEN",
          "title": "Tokenenv",
          "type": "string"
        },
        "requireTokenRemote": {
          "default": false,
          "title": "Requiretokenremote",
          "type": "boolean"
        },
        "trustProxyHeaders": {
          "default": true,
          "title": "Trustproxyheaders",
          "type": "boolean"
        },
        "rateLimitPerMinute": {
          "default": 600,
          "maximum": 100000,
          "minimum": 0,
          "title": "Ratelimitperminute",
          "type": "integer"
        }
      },
      "title": "ApiConfig",
      "type": "object"
    },
    "BackupConfig": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "autoBeforeMigration": {
          "default": true,
          "title": "Autobeforemigration",
          "type": "boolean"
        },
        "includeArtifacts": {
          "default": true,
          "title": "Includeartifacts",
          "type": "boolean"
        }
      },
      "title": "BackupConfig",
      "type": "object"
    },
    "BudgetConfig": {
      "additionalProperties": false,
      "properties": {
        "maxStepsPerTurn": {
          "default": 50,
          "maximum": 1000,
          "minimum": 1,
          "title": "Maxstepsperturn",
          "type": "integer"
        },
        "maxDurationSeconds": {
          "default": 900,
          "maximum": 86400,
          "minimum": 10,
          "title": "Maxdurationseconds",
          "type": "integer"
        },
        "maxCostPerTurn": {
          "default": 1.0,
          "minimum": 0,
          "title": "Maxcostperturn",
          "type": "number"
        },
        "maxRepeatFailures": {
          "default": 3,
          "maximum": 20,
          "minimum": 1,
          "title": "Maxrepeatfailures",
          "type": "integer"
        },
        "maxToolOutputChars": {
          "default": 24000,
          "maximum": 2000000,
          "minimum": 1000,
          "title": "Maxtooloutputchars",
          "type": "integer"
        }
      },
      "title": "BudgetConfig",
      "type": "object"
    },
    "CommandPermission": {
      "additionalProperties": false,
      "properties": {
        "default": {
          "enum": [
            "allow",
            "ask",
            "deny"
          ],
          "type": "string",
          "default": "ask",
          "title": "Default"
        },
        "allow": {
          "items": {
            "type": "string"
          },
          "title": "Allow",
          "type": "array"
        },
        "deny": {
          "items": {
            "type": "string"
          },
          "title": "Deny",
          "type": "array"
        }
      },
      "title": "CommandPermission",
      "type": "object"
    },
    "CompactionConfig": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "keepRecentTokens": {
          "default": 4000,
          "maximum": 200000,
          "minimum": 500,
          "title": "Keeprecenttokens",
          "type": "integer"
        },
        "triggerRatio": {
          "default": 0.85,
          "exclusiveMinimum": 0,
          "maximum": 1.0,
          "title": "Triggerratio",
          "type": "number"
        },
        "useModel": {
          "default": false,
          "title": "Usemodel",
          "type": "boolean"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "summaryMaxTokens": {
          "default": 2000,
          "maximum": 16000,
          "minimum": 256,
          "title": "Summarymaxtokens",
          "type": "integer"
        },
        "reloadProjectRules": {
          "default": true,
          "title": "Reloadprojectrules",
          "type": "boolean"
        }
      },
      "title": "CompactionConfig",
      "type": "object"
    },
    "DefaultsConfig": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "default": "mock/echo",
          "title": "Model",
          "type": "string"
        },
        "reasoningLevel": {
          "default": "off",
          "title": "Reasoninglevel",
          "type": "string"
        },
        "agent": {
          "default": "build",
          "title": "Agent",
          "type": "string"
        },
        "mode": {
          "default": "build",
          "enum": [
            "build",
            "plan"
          ],
          "title": "Mode",
          "type": "string"
        },
        "fallbackModels": {
          "items": {
            "type": "string"
          },
          "title": "Fallbackmodels",
          "type": "array"
        },
        "visionModel": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Visionmodel"
        },
        "compactionModel": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Compactionmodel"
        }
      },
      "title": "DefaultsConfig",
      "type": "object"
    },
    "FormatterConfig": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "commands": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Commands",
          "type": "object"
        }
      },
      "title": "FormatterConfig",
      "type": "object"
    },
    "GeneralConfig": {
      "additionalProperties": false,
      "properties": {
        "language": {
          "default": "zh-CN",
          "enum": [
            "zh-CN",
            "en-US"
          ],
          "title": "Language",
          "type": "string"
        },
        "theme": {
          "default": "system",
          "enum": [
            "light",
            "dark",
            "system"
          ],
          "title": "Theme",
          "type": "string"
        },
        "notifications": {
          "default": true,
          "title": "Notifications",
          "type": "boolean"
        }
      },
      "title": "GeneralConfig",
      "type": "object"
    },
    "HookConfig": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "events": {
          "items": {
            "type": "string"
          },
          "title": "Events",
          "type": "array"
        }
      },
      "title": "HookConfig",
      "type": "object"
    },
    "MetricsConfig": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        }
      },
      "title": "MetricsConfig",
      "type": "object"
    },
    "ModelConfig": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "default": "",
          "title": "Name",
          "type": "string"
        },
        "contextWindow": {
          "default": 128000,
          "minimum": 1000,
          "title": "Contextwindow",
          "type": "integer"
        },
        "maxOutput": {
          "default": 8192,
          "minimum": 1,
          "title": "Maxoutput",
          "type": "integer"
        },
        "capabilities": {
          "items": {
            "type": "string"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "reasoningLevels": {
          "items": {
            "type": "string"
          },
          "title": "Reasoninglevels",
          "type": "array"
        },
        "pricing": {
          "$ref": "#/$defs/ModelPricing"
        },
        "structuredOutput": {
          "default": false,
          "title": "Structuredoutput",
          "type": "boolean"
        }
      },
      "required": [
        "id"
      ],
      "title": "ModelConfig",
      "type": "object"
    },
    "ModelPricing": {
      "additionalProperties": false,
      "properties": {
        "inputPerMillion": {
          "default": 0.0,
          "title": "Inputpermillion",
          "type": "number"
        },
        "outputPerMillion": {
          "default": 0.0,
          "title": "Outputpermillion",
          "type": "number"
        },
        "cacheHitPerMillion": {
          "default": 0.0,
          "title": "Cachehitpermillion",
          "type": "number"
        }
      },
      "title": "ModelPricing",
      "type": "object"
    },
    "NetworkConfig": {
      "additionalProperties": false,
      "properties": {
        "proxy": {
          "default": "",
          "title": "Proxy",
          "type": "string"
        },
        "caBundle": {
          "default": "",
          "title": "Cabundle",
          "type": "string"
        },
        "userAgent": {
          "default": "MiniAgent/0.2",
          "title": "Useragent",
          "type": "string"
        }
      },
      "title": "NetworkConfig",
      "type": "object"
    },
    "OAuthConfig": {
      "additionalProperties": false,
      "properties": {
        "tokenUrl": {
          "default": "",
          "title": "Tokenurl",
          "type": "string"
        },
        "clientId": {
          "default": "",
          "title": "Clientid",
          "type": "string"
        },
        "clientSecret": {
          "default": "",
          "title": "Clientsecret",
          "type": "string"
        },
        "scope": {
          "default": "",
          "title": "Scope",
          "type": "string"
        },
        "audience": {
          "default": "",
          "title": "Audience",
          "type": "string"
        }
      },
      "title": "OAuthConfig",
      "type": "object"
    },
    "PermissionConfig": {
      "additionalProperties": false,
      "properties": {
        "read": {
          "$ref": "#/$defs/CommandPermission"
        },
        "write": {
          "$ref": "#/$defs/CommandPermission"
        },
        "shell": {
          "$ref": "#/$defs/CommandPermission"
        },
        "network": {
          "$ref": "#/$defs/CommandPermission"
        },
        "interaction": {
          "$ref": "#/$defs/CommandPermission"
        },
        "task": {
          "$ref": "#/$defs/CommandPermission"
        },
        "mcp": {
          "$ref": "#/$defs/CommandPermission"
        },
        "plugin": {
          "$ref": "#/$defs/CommandPermission"
        },
        "subagent": {
          "$ref": "#/$defs/CommandPermission"
        }
      },
      "title": "PermissionConfig",
      "type": "object"
    },
    "ProviderConfig": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "default": "",
          "title": "Name",
          "type": "string"
        },
        "protocol": {
          "default": "openai-chat",
          "enum": [
            "openai-chat",
            "openai-responses",
            "anthropic",
            "mock"
          ],
          "title": "Protocol",
          "type": "string"
        },
        "baseUrl": {
          "default": "https://api.deepseek.com",
          "title": "Baseurl",
          "type": "string"
        },
        "authType": {
          "default": "api_key",
          "enum": [
            "api_key",
            "oauth_client_credentials",
            "none"
          ],
          "title": "Authtype",
          "type": "string"
        },
        "apiKey": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Apikey"
        },
        "apiKeyEnv": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Apikeyenv"
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Headers",
          "type": "object"
        },
        "oauth": {
          "anyOf": [
            {
              "$ref": "#/$defs/OAuthConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "supportsBalance": {
          "default": false,
          "title": "Supportsbalance",
          "type": "boolean"
        },
        "balancePath": {
          "default": "/user/balance",
          "title": "Balancepath",
          "type": "string"
        },
        "models": {
          "items": {
            "$ref": "#/$defs/ModelConfig"
          },
          "title": "Models",
          "type": "array"
        }
      },
      "required": [
        "id"
      ],
      "title": "ProviderConfig",
      "type": "object"
    },
    "RetentionConfig": {
      "additionalProperties": false,
      "properties": {
        "artifactsDays": {
          "default": 30,
          "maximum": 3650,
          "minimum": 1,
          "title": "Artifactsdays",
          "type": "integer"
        },
        "eventsDays": {
          "default": 90,
          "maximum": 3650,
          "minimum": 1,
          "title": "Eventsdays",
          "type": "integer"
        },
        "logsDays": {
          "default": 30,
          "maximum": 3650,
          "minimum": 1,
          "title": "Logsdays",
          "type": "integer"
        },
        "backupsDays": {
          "default": 30,
          "maximum": 3650,
          "minimum": 1,
          "title": "Backupsdays",
          "type": "integer"
        },
        "uploadsDays": {
          "default": 30,
          "maximum": 3650,
          "minimum": 1,
          "title": "Uploadsdays",
          "type": "integer"
        }
      },
      "title": "RetentionConfig",
      "type": "object"
    },
    "SandboxConfig": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "default": "auto",
          "enum": [
            "none",
            "auto",
            "sandbox-exec",
            "bwrap",
            "docker"
          ],
          "title": "Mode",
          "type": "string"
        },
        "dockerImage": {
          "default": "python:3.13-slim",
          "title": "Dockerimage",
          "type": "string"
        },
        "allowNetwork": {
          "default": false,
          "title": "Allownetwork",
          "type": "boolean"
        }
      },
      "title": "SandboxConfig",
      "type": "object"
    },
    "SearchConfig": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "default": "duckduckgo",
          "enum": [
            "duckduckgo",
            "tavily"
          ],
          "title": "Provider",
          "type": "string"
        },
        "apiKey": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Apikey"
        },
        "apiKeyEnv": {
          "default": "TAVILY_API_KEY",
          "title": "Apikeyenv",
          "type": "string"
        },
        "maxResults": {
          "default": 5,
          "maximum": 20,
          "minimum": 1,
          "title": "Maxresults",
          "type": "integer"
        }
      },
      "title": "SearchConfig",
      "type": "object"
    },
    "SecurityConfig": {
      "additionalProperties": false,
      "properties": {
        "allowOutsideWorkspace": {
          "default": false,
          "title": "Allowoutsideworkspace",
          "type": "boolean"
        },
        "maxUploadMb": {
          "default": 20,
          "maximum": 500,
          "minimum": 1,
          "title": "Maxuploadmb",
          "type": "integer"
        },
        "maxFileReadBytes": {
          "default": 512000,
          "maximum": 20000000,
          "minimum": 1000,
          "title": "Maxfilereadbytes",
          "type": "integer"
        },
        "shellTimeoutSeconds": {
          "default": 60,
          "maximum": 3600,
          "minimum": 1,
          "title": "Shelltimeoutseconds",
          "type": "integer"
        },
        "blockPrivateNetwork": {
          "default": true,
          "title": "Blockprivatenetwork",
          "type": "boolean"
        }
      },
      "title": "SecurityConfig",
      "type": "object"
    },
    "ServerConfig": {
      "additionalProperties": false,
      "properties": {
        "host": {
          "default": "127.0.0.1",
          "title": "Host",
          "type": "string"
        },
        "port": {
          "default": 8787,
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        },
        "corsOrigins": {
          "items": {
            "type": "string"
          },
          "title": "Corsorigins",
          "type": "array"
        },
        "requestTimeoutSeconds": {
          "default": 120,
          "maximum": 3600,
          "minimum": 1,
          "title": "Requesttimeoutseconds",
          "type": "integer"
        },
        "logLevel": {
          "default": "INFO",
          "title": "Loglevel",
          "type": "string"
        }
      },
      "title": "ServerConfig",
      "type": "object"
    },
    "SubagentConfig": {
      "additionalProperties": false,
      "properties": {
        "maxDepth": {
          "default": 2,
          "maximum": 8,
          "minimum": 1,
          "title": "Maxdepth",
          "type": "integer"
        },
        "maxConcurrent": {
          "default": 3,
          "maximum": 32,
          "minimum": 1,
          "title": "Maxconcurrent",
          "type": "integer"
        },
        "timeoutSeconds": {
          "default": 600,
          "maximum": 86400,
          "minimum": 10,
          "title": "Timeoutseconds",
          "type": "integer"
        },
        "backgroundTimeoutSeconds": {
          "default": 3600,
          "maximum": 86400,
          "minimum": 10,
          "title": "Backgroundtimeoutseconds",
          "type": "integer"
        }
      },
      "title": "SubagentConfig",
      "type": "object"
    },
    "TaskConfig": {
      "additionalProperties": false,
      "properties": {
        "waitTimeoutSeconds": {
          "default": 120,
          "maximum": 3600,
          "minimum": 1,
          "title": "Waittimeoutseconds",
          "type": "integer"
        },
        "autoContinueAfterCompletion": {
          "default": true,
          "title": "Autocontinueaftercompletion",
          "type": "boolean"
        },
        "maxDurationSeconds": {
          "default": 3600,
          "maximum": 86400,
          "minimum": 1,
          "title": "Maxdurationseconds",
          "type": "integer"
        }
      },
      "title": "TaskConfig",
      "type": "object"
    },
    "ToolsConfig": {
      "additionalProperties": false,
      "properties": {
        "parallelReadOnly": {
          "default": true,
          "title": "Parallelreadonly",
          "type": "boolean"
        },
        "format": {
          "$ref": "#/$defs/FormatterConfig"
        }
      },
      "title": "ToolsConfig",
      "type": "object"
    },
    "WebhookConfig": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "maxAttempts": {
          "default": 3,
          "maximum": 10,
          "minimum": 1,
          "title": "Maxattempts",
          "type": "integer"
        },
        "timeoutSeconds": {
          "default": 10,
          "maximum": 120,
          "minimum": 1,
          "title": "Timeoutseconds",
          "type": "integer"
        }
      },
      "title": "WebhookConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "server": {
      "$ref": "#/$defs/ServerConfig"
    },
    "general": {
      "$ref": "#/$defs/GeneralConfig"
    },
    "defaults": {
      "$ref": "#/$defs/DefaultsConfig"
    },
    "providers": {
      "items": {
        "$ref": "#/$defs/ProviderConfig"
      },
      "title": "Providers",
      "type": "array"
    },
    "permissions": {
      "$ref": "#/$defs/PermissionConfig"
    },
    "budget": {
      "$ref": "#/$defs/BudgetConfig"
    },
    "compaction": {
      "$ref": "#/$defs/CompactionConfig"
    },
    "tasks": {
      "$ref": "#/$defs/TaskConfig"
    },
    "security": {
      "$ref": "#/$defs/SecurityConfig"
    },
    "network": {
      "$ref": "#/$defs/NetworkConfig"
    },
    "search": {
      "$ref": "#/$defs/SearchConfig"
    },
    "subagents": {
      "$ref": "#/$defs/SubagentConfig"
    },
    "tools": {
      "$ref": "#/$defs/ToolsConfig"
    },
    "sandbox": {
      "$ref": "#/$defs/SandboxConfig"
    },
    "retention": {
      "$ref": "#/$defs/RetentionConfig"
    },
    "metrics": {
      "$ref": "#/$defs/MetricsConfig"
    },
    "api": {
      "$ref": "#/$defs/ApiConfig"
    },
    "webhooks": {
      "$ref": "#/$defs/WebhookConfig"
    },
    "hooks": {
      "$ref": "#/$defs/HookConfig"
    },
    "backup": {
      "$ref": "#/$defs/BackupConfig"
    },
    "dataDir": {
      "format": "path",
      "title": "Datadir",
      "type": "string"
    },
    "workspaceRoot": {
      "format": "path",
      "title": "Workspaceroot",
      "type": "string"
    },
    "configPath": {
      "anyOf": [
        {
          "format": "path",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Configpath"
    },
    "policyPath": {
      "anyOf": [
        {
          "format": "path",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Policypath"
    },
    "source": {
      "default": "built-in",
      "title": "Source",
      "type": "string"
    }
  },
  "title": "Mini Agent configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mini-agent.local/config.schema.json"
}
